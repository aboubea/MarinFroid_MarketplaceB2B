# Neon Postgres connection string (pooled, HTTP driver compatible)
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/marinfroid?sslmode=require"

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Resend transactional email
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="Marin Froid <commandes@marinfroid.fr>"

# Public base URL used to build links in emails
APP_URL="http://localhost:3000"
